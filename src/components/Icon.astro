---
// Tabler ikonlarını (@tabler/icons, MIT) derleme sırasında SVG olarak gömer;
// çalışma anında CDN'e ihtiyaç kalmaz. Boyut font-size ile ölçeklenir (1em).
import { readFile } from 'node:fs/promises';

interface Props {
  name: string;
  class?: string;
  label?: string; // verilirse role="img" + aria-label; verilmezse dekoratif (aria-hidden)
}

const { name, class: cls, label } = Astro.props;

const raw = await readFile(
  new URL(`../../node_modules/@tabler/icons/icons/outline/${name}.svg`, import.meta.url),
  'utf-8'
);
const svg = raw
  .replace('width="24"', 'width="1em"')
  .replace('height="24"', 'height="1em"')
  .replace('class="', `class="ti ${cls ? cls + ' ' : ''}`)
  .replace(
    '<svg',
    label ? `<svg role="img" aria-label="${label}"` : '<svg aria-hidden="true"'
  );
---

<Fragment set:html={svg} />
